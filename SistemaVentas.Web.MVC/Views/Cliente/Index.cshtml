@model IEnumerable<SistemaVentas.Dominio.Modelos.Cliente>

<h1>Listado de Clientes</h1>

<p>
    <a href="/clientes/crear" class="btn btn-primary">Crear Nuevo Cliente</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.IdCliente</td>
                <td>@cliente.Nombre</td>
                <td>@cliente.Apellidos</td>
                <td>
                    <a href="/clientes/editar/@cliente.IdCliente" class="btn btn-warning">Editar</a>
                    <a href="/clientes/eliminar/@cliente.IdCliente" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
