@page
@model SistemaVentas.Web.RazorPages.Pages.Categorias.IndexModel
@{
}


<h1>Listado de categorias</h1>

<table class="table">
    <tr>
        <th>Código</th>
        <th>Nombre</th>
    </tr>

    @foreach (var item in Model.ListaCategorias)
    {
        <tr>
            <td>@item.IdCategoria</td>
            <td>@item.Nombre</td>
        </tr>
    }
</table>